{
  "name": "coworking-xp-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de reservas de coworking desarrollada con prácticas XP y BDD",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "eslint src tests",
    "test": "npm run test:e2e",
    "test:e2e": "cucumber-js --config cucumber.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@cucumber/cucumber": "^11.3.0",
    "eslint": "^9.19.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
